{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automatic-agent.local/schemas/review-source-coverage-report.schema.json",
  "title": "Review Source Coverage Report",
  "type": "object",
  "required": ["generatedAt", "reviewSources", "unscannedReviewFiles", "filesWithParseWarnings", "overallStatus"],
  "properties": {
    "generatedAt": { "type": "string", "minLength": 1 },
    "reviewSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceFile",
          "detectedRows",
          "rawImportedRows",
          "normalizedLinkedRows",
          "droppedRows",
          "dropReasons"
        ],
        "properties": {
          "sourceFile": { "type": "string", "minLength": 1 },
          "detectedRows": { "type": "integer", "minimum": 0 },
          "rawImportedRows": { "type": "integer", "minimum": 0 },
          "normalizedLinkedRows": { "type": "integer", "minimum": 0 },
          "droppedRows": { "type": "integer", "minimum": 0 },
          "dropReasons": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "unscannedReviewFiles": { "type": "array", "items": { "type": "string" } },
    "filesWithParseWarnings": { "type": "array", "items": { "type": "object" } },
    "overallStatus": { "type": "string", "enum": ["pass", "partial", "fail"] }
  },
  "additionalProperties": false
}
