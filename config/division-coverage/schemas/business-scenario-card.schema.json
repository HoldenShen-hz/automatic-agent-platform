{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aa://division-coverage/business-scenario-card.schema.json",
  "type": "object",
  "required": [
    "scenarioId",
    "divisionId",
    "familyId",
    "userGoal",
    "canonicalWorkflow",
    "supportedAgentTasks",
    "inputDataTypes",
    "outputActions",
    "outputActionBindings",
    "toolActions",
    "riskLevel",
    "autonomyAllowed",
    "evalSuiteRef",
    "redTeamSuiteRef",
    "successMetrics",
    "safetyMetrics",
    "roiMetrics",
    "releaseGateRef"
  ],
  "properties": {
    "scenarioId": { "type": "string" },
    "divisionId": { "type": "string" },
    "familyId": { "type": "string" },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "autonomyAllowed": {
      "type": "string",
      "enum": ["read_only", "draft_only", "hitl_required", "prepared_action_only", "no_autonomous_high_impact_action"]
    },
    "outputActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputActionBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outputActionId", "bindingType"],
        "properties": {
          "outputActionId": { "type": "string", "minLength": 1 },
          "bindingType": {
            "type": "string",
            "enum": ["tool_action", "derived_artifact", "response_artifact", "decision_record"]
          },
          "toolId": { "type": "string", "minLength": 1 },
          "actionId": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "bindingType": { "const": "tool_action" }
              }
            },
            "then": {
              "required": ["toolId", "actionId"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "redTeamSuiteRef": {
      "type": "string",
      "minLength": 1
    },
    "toolActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["toolId", "actionId", "riskClass"],
        "properties": {
          "toolId": { "type": "string" },
          "actionId": { "type": "string" },
          "riskClass": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "riskLevel": {
            "enum": ["high", "critical"]
          }
        }
      },
      "then": {
        "required": ["redTeamSuiteRef"],
        "properties": {
          "redTeamSuiteRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
