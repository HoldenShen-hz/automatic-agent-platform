{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aa://redteam/redteam-suite.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "divisionId",
    "caseCount",
    "reportRef",
    "lastRefreshedAt",
    "cases",
    "runner",
    "result",
    "criticalSuccessCount",
    "releaseBlocking"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "redteam/schemas/redteam-suite.schema.json"
    },
    "divisionId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1
    },
    "reportRef": {
      "type": "string",
      "pattern": "^docs_zh/divisions/[a-z0-9-]+/leadership-evidence/redteam-report\\.md$"
    },
    "lastRefreshedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "severity", "objective", "scope", "evidenceRefs"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "objective": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "runner": {
      "type": "object",
      "required": ["runnerId", "runnerVersion", "implementationRef"],
      "properties": {
        "runnerId": { "type": "string", "minLength": 1 },
        "runnerVersion": { "type": "string", "minLength": 1 },
        "implementationRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": ["object", "string"]
    },
    "criticalSuccessCount": {
      "type": "integer",
      "minimum": 1
    },
    "releaseBlocking": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
